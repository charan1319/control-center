{
  "name": "control-center",
  "version": "1.0.0",
  "type": "module",
  "description": "Self-hosted dashboard for monitoring and managing Claude Code sessions",
  "author": "Charan Santhirasegaran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charan1319/control-center.git"
  },
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "concurrently -n server,client -c blue,green \"node --env-file-if-exists=.env --watch server.js\" \"npx vite --config client/vite.config.ts\"",
    "build": "npx vite build --config client/vite.config.ts",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^11.8.0",
    "fastify": "^5.2.0",
    "node-pty": "^1.0.0",
    "web-push": "^3.6.7",
    "react": "^19",
    "react-dom": "^19",
    "@xterm/xterm": "^5.5",
    "@xterm/addon-fit": "^0.10",
    "@xterm/addon-web-links": "^0.11"
  },
  "devDependencies": {
    "vite": "^6",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9"
  }
}
