# ─────────────────────────────────────────────────────────────
# Control Center — Environment Configuration
# Copy this file to .env and edit as needed:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
CC_PORT=7700
CC_HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────
# Path to the SQLite database file (relative to the install directory)
CC_DB_PATH=./data/control-center.sqlite

# ── AI Summaries (DeepSeek) ──────────────────────────────────
# Get a key at https://platform.deepseek.com
# Leave blank to disable AI summaries.
# DEEPSEEK_API_KEY=sk-...

# Set to false to disable AI summaries without removing the key
CC_AI_SUMMARY=true

# ── Auto-Approve Permissions ────────────────────────────────
# Comma-separated tool names that are silently approved (no user prompt)
CC_AUTO_APPROVE_TOOLS=Read,Glob,Grep,WebFetch,WebSearch,LS

# Regex pattern for auto-approving Bash commands (read-only commands)
# This is currently hardcoded in config.js — shown here for reference.
# CC_AUTO_APPROVE_BASH_PATTERN=^(ls|ll|find|tree|cat|head|tail|wc|grep|rg|python[0-9.]*|git\s+(status|log|diff|show|branch|stash\s+list|remote\s+-v)|ps|df|du|free|uname|hostname|echo|pwd|which|date|printenv|env)(\s|$)

# ── Session Cleanup ─────────────────────────────────────────
# Auto-delete stopped sessions older than N days (0 = disabled)
CC_SESSION_CLEANUP_DAYS=7

# ── Web Push Notifications (PWA) ────────────────────────────
# Required for browser push notifications (needs HTTPS via Tailscale Serve)
# Generate VAPID keys once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:you@example.com

# ── Usage Stats ──────────────────────────────────────────────
# Set to false to disable anonymous usage statistics
# CC_TELEMETRY=false

# ── Hook Server URL ─────────────────────────────────────────
# If you change CC_PORT, also set this so hook scripts reach the server.
# Export this in your shell profile (~/.bashrc or ~/.zshrc):
#   export CC_SERVER_URL=http://127.0.0.1:YOUR_PORT
# CC_SERVER_URL=http://127.0.0.1:7700
